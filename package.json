{
  "name": "verified-recipes",
  "version": "0.1.0",
  "description": "Verified, CI-tested coding recipes for AI agents",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierreAngeloAA/verified-recipes.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "test": "node --test \"tools/**/*.test.mjs\" \"mcp/**/*.test.mjs\"",
    "verify": "node tools/verify.mjs",
    "build": "node tools/build.mjs",
    "prepack": "npm run build",
    "smoke": "node tools/mcp-smoke.mjs",
    "eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "bin": {
    "verified-recipes": "mcp/server.mjs"
  },
  "files": [
    "mcp/server.mjs",
    "mcp/search.mjs",
    "site/index.json"
  ]
}
